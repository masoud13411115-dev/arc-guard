<!--
  ARC Guard — Android Permissions Reference
  ==========================================
  Copy these <uses-permission> entries into:
    android/app/src/main/AndroidManifest.xml
  inside the <manifest> element, BEFORE the <application> block.

  These are generated by Capacitor plugins automatically when you run
  `npx cap add android` and `npx cap sync`, but are listed here as
  reference and to ensure nothing is missed.
-->

<!-- ── Network ────────────────────────────────────────────────────────────── -->
<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

<!-- ── Push Notifications ────────────────────────────────────────────────── -->
<!-- Required on Android 13+ (API 33+) -->
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
<!-- FCM wake lock (battery-optimized delivery) -->
<uses-permission android:name="android.permission.WAKE_LOCK" />
<!-- Required for FCM on older Android -->
<uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />

<!-- ── GPS / Location ─────────────────────────────────────────────────────── -->
<!-- Precise location — required for patrol radius check -->
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
<!-- Coarse location fallback -->
<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
<!-- Optional: background GPS for auto-location while app is minimized -->
<!-- Requires additional Play Store declaration if used -->
<!-- <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" /> -->

<!-- ── Camera (QR scanning) ───────────────────────────────────────────────── -->
<uses-permission android:name="android.permission.CAMERA" />
<!-- Declare camera feature (not required, marks app as needing camera on Play Store) -->
<uses-feature android:name="android.hardware.camera" android:required="true" />
<uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

<!-- ── Vibration ──────────────────────────────────────────────────────────── -->
<uses-permission android:name="android.permission.VIBRATE" />

<!-- ── Notification channels (Android 8+) ────────────────────────────────── -->
<!--
  Channels are created in code by nativePush.ts via PushNotifications.createChannel().
  No manifest entries needed for channels.
-->

